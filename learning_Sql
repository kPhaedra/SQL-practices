-- 1//SELECT : mean show me *: eveerything  FROM... : inside...
SELECT * FROM Client ;

-- 2//TOP 4 : like 1 to 4 not everything;
SELECT TOP 5 * FROM CatalogueProduit ;

-- 3//For seeing only country that is pays here
SELECT Pays  FROM Client ;
SELECT ClientType , ClientNom  FROM Client ;-- do not put a star for this one 

-- 4//ASC : from the smallest to the tallest one 
SELECT TOP 5 * FROM Client 
ORDER BY ClientNom  ASC;

-- 5//now COUNT() : calculate like adding after you will give a name to that column
SELECT COUNT(*) AS totalClients 
FROM Client ;

