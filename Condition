-- file 03: Combined Conditions (AND, OR, BETWEEN)

-- Challenge 1: Find all clients located in 'France' AND whose name starts with 'M'
-- very easy
SELECT *
FROM Client 
WHERE Pays = 'France' 
AND ClientNom LIKE 'M%';
/*
CLIENT_2	Mobilier SAS 	PME	France
*/

-- Challenge 2: Find all products in CatalogueProduit with a price BETWEEN 10 and 50
-- easy too
SELECT *
FROM CatalogueProduit  
WHERE PoidsKg 
BETWEEN 10 AND 50;

